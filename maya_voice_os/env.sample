# =============================================================================
# voice-flow configuration — copy this file to `.env` and fill in what you
# have. Nothing here requires a paid plan. Leave any key blank to skip it;
# the LLM router and TTS provider both fall back safely.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM routing (llm-service/llm_router.py, built on homemath)
# Providers are tried in LLM_PROVIDER_ORDER, skipping any with no key set,
# falling through automatically on error/timeout/empty response.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Note: Mistral's free "Experiment" tier requires phone number verification
# to get a key (~1B tokens/month, ~1 req/sec limit).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

LLM_PROVIDER_ORDER=groq,cerebras,mistral,openrouter,ollama
LLM_TIMEOUT=25

# ---------------------------------------------------------------------------
# Redis (smart_memory: cross-turn sales-conversation state — objections,
# buying signals, emotional trend, stage). Real dependency for local runs,
# not silently optional: install Redis and set these so state actually
# persists across restarts and is shareable if you run multiple processes.
#   macOS:   brew install redis && brew services start redis
#   Linux:   sudo apt install redis-server (or your distro's equivalent)
#   Windows: use WSL2 + the Linux instructions, or Docker:
#            docker run -d -p 6379:6379 redis
# Leave REDIS_HOST blank to run without Redis — state then persists only
# in-memory for the life of the running process (lost on restart), which
# still works fine for local testing, just isn't durable.
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Identity (persona)
# ---------------------------------------------------------------------------
IDENTITY_FILE=identity/default.yaml

# ---------------------------------------------------------------------------
# ASR (asr-service/engine.py, faster-whisper)
# ---------------------------------------------------------------------------
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=en
# Beam search width — the biggest speed/accuracy lever for CPU transcription.
# 1 = fastest (good for real-time voice), up to ~5 = more accurate but slower.
ASR_BEAM_SIZE=1
# Leave blank to let ctranslate2 auto-pick thread count (usually all cores).
# Set a number to cap it, e.g. if you want to leave cores free for other apps.
ASR_CPU_THREADS=

# ---------------------------------------------------------------------------
# TTS (tts-service/engine.py)
# TTS_PROVIDER=edge is free and keyless. Set to custom_api to plug in any
# other TTS REST API instead (see tts-service/engine.py CustomAPITTSProvider).
# ---------------------------------------------------------------------------
TTS_PROVIDER=edge
TTS_VOICE=en-US-EmmaMultilingualNeural
# Other options worth trying:
#   en-IN-NeerjaNeural    (Indian-accented English, the previous default)
#   en-IN-PrabhatNeural   (Indian-accented, male)
#   en-US-AvaMultilingualNeural (similar to Emma, alternative natural voice)
TTS_API_URL=
TTS_API_KEY=

# ---------------------------------------------------------------------------
# Orchestration-service (the /process HTTP API — "runs everything")
# ---------------------------------------------------------------------------
ORCHESTRATION_HOST=0.0.0.0
ORCHESTRATION_PORT=8004
# If set, telephony-service (and anyone else) must send this as
# `Authorization: Bearer <token>` to call /process. Strongly recommended if
# this port is reachable from outside your machine.
ORCHESTRATION_API_TOKEN=
ORCHESTRATION_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Telephony-service (provider-agnostic gateway; talks to orchestration-service
# above via ORCHESTRATION_URL — never to any other project's infrastructure)
# ---------------------------------------------------------------------------
TELEPHONY_HOST=0.0.0.0
TELEPHONY_PORT=8100
ORCHESTRATION_URL=http://127.0.0.1:8004
TELEPHONY_PUBLIC_BASE_URL=http://localhost:8100
TELEPHONY_CORS_ORIGINS=*
# Management-endpoint auth (e.g. GET /exotel/sessions/{id})
TELEPHONY_GATEWAY_TOKEN=

# --- Twilio adapter (ready to use — just fill these in) ---
# Only needed to enable webhook signature validation (recommended for
# production). The adapter works without them, just unverified.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=

# --- Exotel-style adapter (turn-based template) ---
# Unguessable secret you put in the webhook URL you give the provider,
# e.g. https://yourhost/exotel/incoming/<this-secret>
EXOTEL_WEBHOOK_SECRET=
